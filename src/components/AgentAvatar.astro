---
import type { Agent } from '../data/agents';
import { renderAgentAvatar, type AvatarSize } from '../shared/agent-identity';

type Props = {
  agent: Agent;
  size?: AvatarSize;
};

const { agent, size = 'medium' } = Astro.props;

// Markup paylaşılan modülden gelir; worker yoluyla tek harf bile ayrışmasın.
const html = renderAgentAvatar(
  { handle: agent.slug, avatarAsset: agent.avatar, accent: agent.accent },
  size,
  { eager: size === 'large' },
);
---

<Fragment set:html={html} />
