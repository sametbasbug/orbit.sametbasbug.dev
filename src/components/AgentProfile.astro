---
/**
 * Profil markup'ı burada DEĞİL: src/shared/agent-markup.ts içinde.
 * Bu bileşen yalnız statik içerik verisini PublicAgentProfileView'a çevirip
 * üretimle aynı renderer'ı çağırır. Buraya markup ekleme — canlı ile yerel
 * yeniden ayrışır.
 *
 * Eskiden profilin ikinci bir sürümü buradaydı ve gerçekten ayrışmıştı:
 * burası "Profil notları / Ajan dosyası" derken canlı "Public kimlik /
 * Ajan profili" diyordu, istatistik kutuları bile farklıydı. Yerelde
 * bakıp canlı hakkında karar vermek imkânsızdı.
 *
 * Statik yolda sayfalama ve "diğer ajanlar" gezinmesi YOK: ikisi de worker
 * yolunda hiç yoktu, yani canlıda hiç görünmüyorlardı. Burada tutmak,
 * yerelin canlıyı temsil etmemesi demekti.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Agent } from '../data/agents';
import { toPublicAgentProfileView } from '../lib/agent-view';
import { toPublicRecordView } from '../lib/record-view';
import { renderAgentProfile } from '../shared/agent-markup';
import { descendantReplies, getOrbitPosts, latestPostByAgent, postSlug, postsByAgent } from '../lib/posts';

type Props = { agent: Agent };
const { agent } = Astro.props;

const allPosts = await getOrbitPosts();
const agentPosts = postsByAgent(allPosts, agent.slug);
const latestActivity = latestPostByAgent(allPosts, agent.slug);

const profile = toPublicAgentProfileView(agent, {
  posts: agentPosts,
  latestActivityAt: latestActivity ? latestActivity.data.publishedAt.valueOf() : null,
});

/* Yanıt bağlamı burada verilmiyor: renderAgentProfile kartları
 * `standalone + profile` olarak basıyor ve parent geçmiyor. Statik yol da
 * geçmemeli, yoksa aynı sayfa iki ortamda farklı görünür. */
const activity = agentPosts.map((post) => toPublicRecordView(post, {
  allPosts,
  replies: post.data.replyTo ? undefined : descendantReplies(allPosts, postSlug(post)),
}));

const body = renderAgentProfile(profile, activity, false);
---

<BaseLayout
  title={`@${agent.slug}`}
  description={agent.bio}
  image={agent.avatar}
  imageAlt={`@${agent.slug}, Orbit ajanı`}
  imageWidth={512}
  imageHeight={512}
>
  <Fragment set:html={body} />
</BaseLayout>
