---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { MOBILE_MORE_NAVIGATION, MOBILE_NAVIGATION, isActive, normalizePath } from '../shared/navigation';

type Props = { currentPath: string };
const { currentPath } = Astro.props;
const normalizedPath = normalizePath(currentPath);

/* Alt çubuk listeyi `src/shared/navigation.ts`'ten okuyor. Bir dönem
   burada ayrı bir liste vardı ve ana sayfanın sol rayındaki listeden
   sessizce kaymıştı: farklı etiketler, farklı sıra, eksik bir madde.

   İletişim çubukta duruyor. Kayıt herkese açıldığına göre bize ulaşmak
   isteyen insan sayısı artacak — şikâyet, itiraz, kaldırma talebi — ve
   ulaşamayan insan, ulaşmaktan vazgeçen insandır. */
const links = MOBILE_NAVIGATION;
const moreLinks = MOBILE_MORE_NAVIGATION;
const moreActive = moreLinks.some((link) => isActive(link, currentPath));
const searchQuery = Astro.url.searchParams.get('q') ?? '';
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Equinox Orbit ana sayfa">
      <span class="brand-mark" aria-hidden="true"><i></i></span>
      {/*
        İki parçanın arasındaki boşluk kozmetik değil. `.brand-copy` bir grid
        olduğu için yalnız boşluktan oluşan metin düğümü ızgara öğesi sayılmaz;
        görünüş değişmez. Ama sayfadan düz metin çıkaran bir okuyucu için fark
        büyük: boşluksuz hâlde marka adı "EquinoxOrbit" olarak çıkıyordu ve
        Google'ın marka doğrulaması "uygulama adı ana sayfadaki adla
        eşleşmiyor" diyerek iki kez reddetti. Ürün adı geçtiği her yerde
        ayrılabilir olmalı; site testi bunu kilitliyor.
      */}
      <span class="brand-copy"><small>Equinox</small>{' '}<strong>Orbit</strong></span>
    </a>

    <nav class="primary-nav" aria-label="Mobil navigasyon">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link, currentPath) ? 'page' : undefined}>
          <Icon name={link.icon} size={18} />
          <span class="nav-label">{link.label}</span>
        </a>
      ))}
      {/*
        Çubuğa sığmayanlar. `<details>` bilerek: sayfa JS'siz açıldığında da
        çalışıyor, yani menü bir script'in inmesini beklemiyor.

        Açık olduğu sayfada `aria-current` özetin üzerinde: içindeki bir
        maddedeyken çubukta hiçbir şeyin işaretli olmaması, kişiye nerede
        olduğunu söylemeyen bir menü demekti.
      */}
      <details class="nav-more">
        {/*
          Etiket kısa: "Daha fazla" 375px'lik bir telefonda yuvaya sığmayıp
          iki satıra taşıyor ve çubuğun dışına çıkıyordu. Erişilebilir ad
          uzun hâlini koruyor.
        */}
        <summary aria-label="Diğer sayfalar" aria-current={moreActive ? 'page' : undefined}>
          <Icon name="chevron" size={18} />
          <span class="nav-label">Diğer</span>
        </summary>
        {/*
          Kendi stilleri var, rayınkini ödünç almıyor.
          
          Bir dönem `app-rail-nav` sınıfını taşıyordu — CSS bütçesinden
          kazanmak içindi — ve iki kez ısırdı: rayın ikon modu menünün
          etiketlerini gizledi, çubuğun `justify-content: center` kuralı da
          ikonları satır uzunluğuna göre kaydırdı. Bir menü panelinin
          ölçüleri bir gezinme rayınınkiyle aynı olmak zorunda değil.
        */}
        <div class="nav-more-sheet">
          {moreLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener' : undefined}
              aria-current={!link.external && isActive(link, currentPath) ? 'page' : undefined}
            >
              <Icon name={link.icon} size={18} />
              <span>{link.label}</span>
            </a>
          ))}
        </div>
      </details>
    </nav>

    <form class="header-search-form" action="/search" method="get" role="search">
      <Icon name="search" size={18} />
      <label class="sr-only" for="header-search-input">Orbit'te ara</label>
      <input
        id="header-search-input"
        name="q"
        type="search"
        value={searchQuery}
        placeholder="Orbit'te ara"
        autocomplete="off"
      />
      <kbd aria-hidden="true">/</kbd>
    </form>

    <div class="header-actions">
      {/*
        Hesabım ve Kaydedilenler header'da YOK: masaüstünde sol rayda,
        mobilde alt çubuğun "Diğer" menüsünde duruyorlar. Bir dönem her üç
        yerde birden vardılar ve mobilde header ikonlarıyla menü içeriği
        birebir aynıydı.

        Arama burada kalıyor ve menüde yok: sık kullanılan bir eylem ve
        büyüteç her yerde tanınan bir işaret; onu bir dokunuş arkasına
        koymanın karşılığı yok.
      */}
      <a class:list={['header-mobile-search', { active: normalizedPath === '/search' }]} href="/search" aria-label="Orbit'te ara" aria-current={normalizedPath === '/search' ? 'page' : undefined}>
        <Icon name="search" size={17} />
      </a>
      {/*
        Duyuru ikonu yalnız dar ekranda. Masaüstünde iki yol zaten var: sol
        raydaki "Duyurular" ve ana sayfanın sağ kolonundaki panel. Mobilde
        ikisi de yok — ray gizli, panel akışın en altına düşüyor — ve
        "Duyurular" alt çubuğun "Diğer" menüsünde, iki dokunuş ve bir sayfa
        yüklemesi uzakta.

        Bir bağlantı, düğme değil: JavaScript inmeden de çalışıyor ve
        `/duyurular` sayfasına götürüyor. Script indiğinde tıklamayı devralıp
        sayfayı yerinde açıyor.

        İki ikon birden basılıyor, hangisinin görüneceğine `data-severity`
        karar veriyor. Alternatif, istemcinin ikonu kendi çizmesiydi — o da
        ikon yollarının ikinci bir kopyası demekti.
      */}
      <a class="header-announcements" href="/duyurular" data-announcement-trigger aria-label="Duyurular">
        <Icon name="info" size={17} className="announcement-icon-info" />
        <Icon name="alert" size={17} className="announcement-icon-alert" />
        <span class="header-announcements-dot" aria-hidden="true"></span>
      </a>
      <ThemeToggle />
      <a class="equinox-link" href="https://equinox.sametbasbug.dev">
        <span class="equinox-link-dot" aria-hidden="true"></span>
        <span>Equinox ağı</span>
        <Icon name="external" size={13} />
      </a>
    </div>
  </div>

  {/*
    Duyuru sayfası. `<dialog>` bilerek: odak tuzağı, Escape ile kapanma ve
    arka planın erişilemez olması tarayıcıdan geliyor — üçünü elle yazmak
    üçünü de yanlış yazma fırsatı demek.

    İçi boş geliyor ve `/duyurular/ozet`ten doluyor. Kabuğa gömmek, duyuru
    markup'ını her sayfanın HTML'ine eklemek olurdu ve o sayfaların çoğu
    worker'dan hiç geçmiyor.
  */}
  <dialog class="announcement-sheet" data-announcement-sheet aria-labelledby="announcement-sheet-title">
    <header class="announcement-sheet-head">
      <h2 id="announcement-sheet-title">Duyurular</h2>
      <button type="button" data-announcement-close aria-label="Kapat">
        <Icon name="chevron" size={18} />
      </button>
    </header>
    <div class="announcement-sheet-body" data-announcement-sheet-body>
      <p class="announcement-panel-empty">Duyurular yükleniyor…</p>
    </div>
    <a class="announcement-sheet-all" href="/duyurular">Duyurular sayfasını aç</a>
  </dialog>
</header>

<style>
  .brand {
    align-items: center;
  }

  .brand > .brand-mark,
  .brand > .brand-copy {
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: normal;
    text-transform: none;
  }
</style>

<script>
  /* Duyuru rozeti ve sayfası.
   *
   * Yalnız ikonun görünür olduğu genişlikte çalışıyor: masaüstünde ikon
   * gizli ve o istek boşuna gider.
   *
   * Okundu bilgisi `localStorage`'da, kimliklerle. Sunucuda tutmuyoruz —
   * ziyaretçi anonim ve bir rozet için hesap açtırmanın anlamı yok. Kimlikle
   * saklamanın sebebi sayıyla saklamamak: geri çekilen bir duyuru sayıyı
   * düşürüyor ve "3 okundu" kaydı yeni duyuruyu okunmuş sayıyordu. */
  const trigger = document.querySelector<HTMLAnchorElement>('[data-announcement-trigger]');
  const sheetDialog = document.querySelector<HTMLDialogElement>('[data-announcement-sheet]');
  const sheetBody = document.querySelector<HTMLElement>('[data-announcement-sheet-body]');

  if (trigger && sheetDialog && sheetBody && getComputedStyle(trigger).display !== 'none') {
    const READ_KEY = 'orbit-announcements-read';

    const readIds = (): Set<string> => {
      try {
        return new Set((localStorage.getItem(READ_KEY) ?? '').split(',').filter(Boolean));
      } catch {
        return new Set();
      }
    };

    let currentIds: string[] = [];

    void (async () => {
      try {
        const response = await fetch('/duyurular/ozet', { headers: { accept: 'text/html' } });
        if (!response.ok) return;
        const template = document.createElement('template');
        template.innerHTML = await response.text();
        const state = template.content.querySelector<HTMLElement>('[data-announcement-state]');
        if (!state) return;

        currentIds = (state.dataset.ids ?? '').split(',').filter(Boolean);
        trigger.dataset.severity = state.dataset.severity ?? 'none';
        sheetBody.replaceChildren(...state.childNodes);

        const seen = readIds();
        const unread = currentIds.filter((id) => !seen.has(id));
        if (unread.length > 0) trigger.dataset.unread = String(unread.length);
      } catch {
        /* Ağ yoksa bağlantı bağlantı olarak kalıyor: tıklayan `/duyurular`
           sayfasına gider. Sessiz başarısızlık burada doğru davranış —
           duyuru rozeti bir hata mesajı göstermeye değecek kadar kritik
           değil ve gösterse her çevrimdışı sekmede bağırırdı. */
      }
    })();

    trigger.addEventListener('click', (event) => {
      /* Yeni sekmede açmak isteyen kişinin niyetini çalmıyoruz. */
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      if (!sheetDialog.showModal) return;
      event.preventDefault();
      sheetDialog.showModal();
      delete trigger.dataset.unread;
      try {
        localStorage.setItem(READ_KEY, currentIds.join(','));
      } catch {}
    });

    sheetDialog.querySelector('[data-announcement-close]')?.addEventListener('click', () => sheetDialog.close());
    /* Sayfanın dışına — yani karartmaya — basmak da kapatıyor. `<dialog>`
       tıklamayı kendi kutusunda alıyor, o yüzden hedefin diyalogun kendisi
       olması "boşluğa basıldı" demek. */
    sheetDialog.addEventListener('click', (event) => {
      if (event.target === sheetDialog) sheetDialog.close();
    });
  }

  /* `<details>` dışarı tıklanınca kendiliğinden kapanmıyor. Menü açık kalıp
     sayfanın üstünde durursa, kişi onu kapatmak için tam da az önce bastığı
     düğmeyi bulmak zorunda kalıyor. Escape de kapatıyor. */
  const sheet = document.querySelector('.nav-more');
  if (sheet instanceof HTMLDetailsElement) {
    document.addEventListener('click', (event) => {
      if (sheet.open && !sheet.contains(event.target as Node)) sheet.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && sheet.open) {
        sheet.open = false;
        sheet.querySelector('summary')?.focus();
      }
    });
  }
</script>
