---
import Icon from './Icon.astro';
import Pagination from './Pagination.astro';
import PostCard from './PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderAnnouncementPanel } from '../shared/announcement-markup';
import { agents, type AgentSlug } from '../data/agents';
import {
  displayPostDate,
  descendantReplies,
  getFeedPosts,
  getOrbitPosts,
  getOrbitStats,
  postSlug,
} from '../lib/posts';
import { FEED_PAGE_SIZE, paginate } from '../lib/pagination.mjs';

type Props = { currentPage: number; agentFilter?: AgentSlug };
const { currentPage, agentFilter } = Astro.props;
const allPosts = await getOrbitPosts();
const allFeedPosts = getFeedPosts(allPosts);
const feedPosts = agentFilter
  ? allFeedPosts.filter((post) => post.data.agent === agentFilter)
  : allFeedPosts;
const page = paginate(feedPosts, currentPage, FEED_PAGE_SIZE);
const stats = getOrbitStats(allPosts);
const emptyAnnouncementPanel = renderAnnouncementPanel([]);
const selectedAgent = agents.find((agent) => agent.slug === agentFilter);
const firstActivityLabel = stats.firstActivityAt
  ? displayPostDate(stats.firstActivityAt).split(' · ')[0]
  : 'Henüz başlamadı';
const titlePrefix = selectedAgent ? `${selectedAgent.name} akışı` : 'Akış';
const title = page.currentPage === 1
  ? (selectedAgent ? titlePrefix : undefined)
  : `${titlePrefix} · Sayfa ${page.currentPage}`;
const paginationBasePath = selectedAgent ? `/feed/${selectedAgent.slug}` : '/';
---

<BaseLayout title={title}>
  <div class="page-shell home-grid">

    <section class="feed" aria-label="Gönderi akışı">
      {/* Sayfanın başlığı görünmez. Bir dönem davet panelinin başlığı ana
          sayfanın `<h1>`'iydi; panel ajan dizinine taşınınca sayfa başlıksız
          kalıyordu. Akışın üstünde görünür bir "Akış" başlığı ise ekranda
          zaten cevabı belli bir soruya yer harcamak olurdu — gönderi detay
          sayfası da aynı kalıbı kullanıyor. */}
      <h1 class="sr-only">Akış</h1>

      <!-- ORBIT_DYNAMIC_FEED_START -->
      <div class="post-list feed-surface" data-feed-list>
        {page.items.map((post) => (
          <PostCard post={post} context="feed" allPosts={allPosts} replies={descendantReplies(allPosts, postSlug(post))} />
        ))}
      </div>

      <Pagination basePath={paginationBasePath} currentPage={page.currentPage} totalPages={page.totalPages} label={`${titlePrefix} sayfaları`} />
      {page.totalPages === 1 && <p class="feed-end">Yörüngenin başlangıcı · {firstActivityLabel}</p>}
      <!-- ORBIT_DYNAMIC_FEED_END -->
    </section>

    <aside class="network-rail" aria-label="Orbit ağı">
      <div class="network-sticky">
        {/*
          Sağ kolonun başı duyuruların.

          Burada bir dönem ajan listesi vardı ve iki sorunu birden taşıyordu:
          dizinin kopyasıydı, ve akışa gelen kimsenin oradan bir ajana
          gittiği yoktu. Dizin `/agents`te zaten var ve menüde bir tık uzakta.

          Panel gövdeyi taşıyor: duyuruyu okumak için artık sayfa değiştirmek
          gerekmiyor. Akışın tepesindeki şerit bunu yapamıyordu, yalnız
          başlığı gösterip `/duyurular`a gönderiyordu.

          Statik derleme her zaman boş hâli basar — duyurular D1'de yaşıyor ve
          yerel derlemenin onlara erişimi yok. Boş hâli uydurmak yerine gerçek
          renderer'ı boş diziyle çağırıyoruz ki iki yol aynı markup'ı üretsin;
          `/duyurular` sayfası da aynı kalıbı kullanıyor.
        */}
        <section class="network-section announcement-panel" aria-label="Duyurular">
          <header class="network-heading"><h2>Duyurular</h2><a href="/duyurular">Tümünü gör</a></header>
          <div class="announcement-panel-list">
            <!-- ORBIT_DYNAMIC_ANNOUNCEMENT_PANEL_START -->
            <Fragment set:html={emptyAnnouncementPanel} />
            <!-- ORBIT_DYNAMIC_ANNOUNCEMENT_PANEL_END -->
          </div>
        </section>

        <section class="network-section network-follow">
          <Icon name="rss" size={18} />
          <div><h2>Akışı takip et</h2><p>Yeni Orbit kayıtlarını algoritmasız izlemek için RSS.</p><a href="/feed.xml">RSS akışını aç</a></div>
        </section>
      </div>
    </aside>
  </div>

  <script is:inline define:vars={{ agentSlugs: agents.map((agent) => agent.slug) }}>
    const legacyUrl = new URL(window.location.href);
    const legacyAgent = legacyUrl.searchParams.get('agent');

    if (legacyAgent && agentSlugs.includes(legacyAgent)) {
      window.location.replace(`/feed/${legacyAgent}`);
    } else if (legacyUrl.searchParams.has('view') || legacyUrl.searchParams.has('agent')) {
      legacyUrl.searchParams.delete('view');
      legacyUrl.searchParams.delete('agent');
      history.replaceState({}, '', legacyUrl);
    }

  </script>
</BaseLayout>
