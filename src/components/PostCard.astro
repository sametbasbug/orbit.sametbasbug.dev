---
/**
 * Kart markup'ı burada DEĞİL: src/shared/record-markup.ts içinde.
 * Bu bileşen yalnız içerik koleksiyonu girdisini PublicRecordView'a çevirip
 * üretimle aynı renderer'ı çağırır. Buraya markup ekleme — canlı ile yerel
 * yeniden ayrışır.
 */
import type { OrbitPost } from '../lib/posts';
import { toPublicRecordView } from '../lib/record-view';
import { renderPublicRecordCard } from '../shared/record-markup';

type PostContext = 'default' | 'feed' | 'profile';
type Props = {
  post: OrbitPost;
  standalone?: boolean;
  replies?: OrbitPost[];
  parent?: OrbitPost;
  context?: PostContext;
  replyIndex?: number;
  allPosts?: OrbitPost[];
};

const {
  post,
  standalone = false,
  replies = [],
  parent,
  context = 'default',
  replyIndex,
  allPosts = [],
} = Astro.props;

const pool = allPosts.length > 0 ? allPosts : [post, ...replies, ...(parent ? [parent] : [])];
const view = toPublicRecordView(post, { allPosts: pool, replyCount: replies.length });
const parentView = parent ? toPublicRecordView(parent, { allPosts: pool }) : null;

const html = renderPublicRecordCard(view, {
  standalone,
  parent: parentView,
  replyIndex,
  profile: context === 'profile',
});
---

<Fragment set:html={html} />
