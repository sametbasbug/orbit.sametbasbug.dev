{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-v6-slice1-integration-tests",
  "main": "scripts/orbit-slice1-test-worker.ts",
  "compatibility_date": "2026-07-15",
  "vars": {
    "ORBIT_ENVIRONMENT": "test",
    "ORBIT_DEPLOYMENT_MODE": "live",
    "ORBIT_ALLOWED_ORIGIN": "http://localhost:4321",
    "ORBIT_GOOGLE_CALLBACK_URL": "http://localhost:4321/v1/auth/google/callback",
    "ORBIT_OPEN_REGISTRATION": "true",
    "ORBIT_BACKUP_ENABLED": "true",
    "ORBIT_MEDIA_ENABLED": "true",
    "GOOGLE_OAUTH_CLIENT_ID": "test-google-client-id",
    "GOOGLE_OAUTH_CLIENT_SECRET": "test-google-client-secret",
    "ORBIT_INVITATION_PEPPER_V1": "test-invitation-pepper-at-least-32-bytes-long",
    "ORBIT_SESSION_PEPPER_V1": "test-session-pepper-at-least-32-bytes-long",
    "ORBIT_AGENT_CREDENTIAL_PEPPER_V1": "test-agent-pepper-at-least-32-bytes-long",
    "ORBIT_OAUTH_STATE_PEPPER_V1": "test-oauth-pepper-at-least-32-bytes-long",
    "ORBIT_CSRF_PEPPER_V1": "test-csrf-pepper-at-least-32-bytes-long",
    "ORBIT_CURSOR_PEPPER_V1": "test-cursor-pepper-at-least-32-bytes-long",
    "ORBIT_MCP_DELEGATION_PEPPER_V1": "test-mcp-delegation-pepper-at-least-32-bytes-long",
    "ORBIT_MCP_SERVICE_SECRET_V1": "test-mcp-service-secret-at-least-32-bytes-long",
    // Alt site giriş kapısı (Plan 008). Anahtar yalnız bu test yapılandırması
    // için üretildi ve hiçbir ortamda kullanılmıyor; testin imzayı gerçekten
    // doğrulaması için sabit olması gerekiyor.
    "ORBIT_SITE_TOKEN_PEPPER_V1": "test-site-token-pepper-at-least-32-bytes-long",
    "ORBIT_OIDC_SIGNING_KEY_V1": "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"QvYOewHD4UgBOH7GVeR34M4cdz7tJ50K5wNL2JEfkL0\",\"y\":\"aDe6fnKKjeO2RSYYlC95owyOXVCGuAv98_4RKAVpYYw\",\"d\":\"cUOIciAos5YWmEX3OMWpL4fH7fPom7DQ1fHVqVff1tg\",\"kid\":\"orbit-oidc-test\"}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "orbit-v6-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": false
  }
}
